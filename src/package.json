{
  "name": "influencer-transcript-translator",
  "private": true,
  "version": "0.1.0",
  "description": "Paste Instagram/TikTok/YouTube post URLs, get English transcripts. Standalone app — do not entangle with the repo-root dashboard.",
  "scripts": {
